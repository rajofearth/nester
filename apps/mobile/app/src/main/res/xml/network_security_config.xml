<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- TODO(v1): tighten this when the host serves HTTPS. Android network
         security config does not support IP CIDR ranges, so for v1 we allow
         cleartext globally so the Rust host can be reached over plain HTTP
         on LAN IPs (10.x, 172.16-31.x, 192.168.x). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
